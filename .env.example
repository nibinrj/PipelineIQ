# Local development only. Copy to .env (gitignored) and change the passwords.
# Passwords must be URL-safe: compose interpolates POSTGRES_PASSWORD into
# PIPELINEIQ_DATABASE_URL. These values are placeholders, not production secrets.

POSTGRES_PASSWORD=pipelineiq-local-only
GRAFANA_ADMIN_PASSWORD=pipelineiq-local-only

# Used when you run the binary on the host against the published Postgres port.
# The compose service sets its own URL and does not read this line.
PIPELINEIQ_DATABASE_URL=postgres://pipelineiq:pipelineiq-local-only@localhost:5432/pipelineiq?sslmode=disable
PIPELINEIQ_HTTP_ADDR=:8080
PIPELINEIQ_SHUTDOWN_TIMEOUT=10s
PIPELINEIQ_READY_TIMEOUT=2s
PIPELINEIQ_LOG_LEVEL=info
