# Local development only. Copy to .env (gitignored) and change the passwords.
# Passwords must be URL-safe: compose interpolates POSTGRES_PASSWORD into
# PIPELINEIQ_DATABASE_URL. These values are placeholders, not production secrets.

POSTGRES_PASSWORD=pipelineiq-local-only
GRAFANA_ADMIN_PASSWORD=pipelineiq-local-only

# Used when you run the binary on the host against the published Postgres port.
# The compose service sets its own URL and does not read this line.
PIPELINEIQ_DATABASE_URL=postgres://pipelineiq:pipelineiq-local-only@localhost:5432/pipelineiq?sslmode=disable
PIPELINEIQ_HTTP_ADDR=:8080
PIPELINEIQ_SHUTDOWN_TIMEOUT=10s
PIPELINEIQ_READY_TIMEOUT=2s
PIPELINEIQ_LOG_LEVEL=info

# Bearer token for POST /api/v1/builds and the quarantine API. Required. Local placeholder, not a production secret.
# Optional flat rules file. See docs/study/P3-flaky-and-quarantine.md. Unset uses the plan defaults.
# PIPELINEIQ_RULES_FILE=
PIPELINEIQ_INGEST_KEY=pipelineiq-local-ingest-key

# Jenkins local admin. The controller reads these through compose.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=pipelineiq-local-only

# Fine-grained GitHub token for branch indexing. Leave this unset until you have one.
# Compose then uses the placeholder local-unset. A bad token fails the scan; it does
# not stop Jenkins. Public repos still need a token because the seed job sets scanCredentialsId.
GITHUB_TOKEN=

# Branch or tag the controller checks out for the shared library.
# Use the branch that contains shared-library/. The sandbox branch is not main.
PIPELINEIQ_LIBRARY_REF=arena/750d568c-pipelineiq
